// Prisma schema file for SPMB SMK Muhammadiyah Sekampung (PPDB-MUSKA)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StatusVerifikasi {
  PENDING
  VALID
  INVALID
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nama      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  pendaftaran Pendaftaran?
}

model Pendaftaran {
  id           String           @id @default(uuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id])
  
  // Nomor Registrasi & Ujian
  nomorPendaftaran String?
  
  // Data Diri
  namaLengkap  String?
  jenisKelamin String?          // Laki-laki / Perempuan
  agama        String?          // Islam, Kristen, Katolik, Hindu, Budha, Khonghucu
  tempatLahir  String?
  tanggalLahir String?
  alamat       String?
  noHpWa       String?
  sekolahAsal  String?
  nisn         String           @unique
  nik          String

  // Data Fisik
  beratBadan   Float?
  tinggiBadan  Float?

  // Data Orang Tua
  namaAyah      String?
  pekerjaanAyah String?
  namaIbu       String?
  namaIbuKandung String?
  pekerjaanIbu  String?
  alamatOrtu    String?
  noHpOrtu      String?

  // Data Wali Murid
  namaWali      String?
  alamatWali    String?
  noHpWali      String?

  // Pilihan Jurusan
  jurusan       String

  // Ukuran Baju
  ukuranBaju        String?
  ukuranBajuLainnya String?

  // Intrakurikuler & Ekstrakurikuler
  intrakurikuler  String?
  ekstrakurikuler String[]       @default([])

  // Status & Verifikasi
  status            StatusVerifikasi @default(PENDING)
  catatanVerifikasi String?
  jadwalUjian       String?
  ruangUjian        String?

  // Pembayaran & Nilai Seleksi
  buktiPembayaran   String?
  statusPembayaran  String?          @default("BELUM_BAYAR")
  nilaiUjian        Float?
  statusKelulusan   String?          @default("MENUNGGU")

  // Lokasi Rumah (GIS Visualisasi Koordinat)
  latitude          Float?
  longitude         Float?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  dokumen      Dokumen[]
}

model Jurusan {
  id            String   @id @default(uuid())
  namaJurusan   String   @unique
  singkatan     String?
  kuotaMaksimal Int      @default(72)
  deskripsi     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Dokumen {
  id              String           @id @default(uuid())
  pendaftaranId   String
  pendaftaran     Pendaftaran      @relation(fields: [pendaftaranId], references: [id])
  jenisDokumen    String           // KTP, KK, Ijazah, Bukti Transfer
  fileUrl         String
  hasiltEkstraksi String?          // Teks hasil OCR dari Python AI
  status          StatusVerifikasi @default(PENDING)
  createdAt       DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminNama  String?
  aksi       String
  detail     String?
  targetUser String?
  createdAt  DateTime @default(now())
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  judul     String
  kategori  String?
  fileUrl   String
  deskripsi String?
  embedded  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

